{
  "entities": {
    "user": {
      "title": "User",
      "description": "Application user profile",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "hasSubscribed": { "type": "boolean" },
        "subscriptionStatus": { "type": "string", "enum": ["none", "pending", "active", "rejected"] },
        "subscriptionType": { "type": "string" },
        "registrationDate": { "type": "string", "format": "date-time" },
        "selfieUrl": { "type": "string" },
        "idUrl": { "type": "string" },
        "popUrl": { "type": "string" }
      },
      "required": ["email", "firstName", "lastName", "hasSubscribed", "subscriptionStatus", "registrationDate"]
    },
    "application": {
      "title": "Application",
      "description": "User subscription application",
      "type": "object",
      "properties": {
        "userEmail": { "type": "string", "format": "email" },
        "userName": { "type": "string" },
        "plan": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "selfieUrl": { "type": "string" },
        "idUrl": { "type": "string" },
        "popUrl": { "type": "string" },
        "referrerEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userEmail", "userName", "plan", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "user" },
      "description": "User profiles"
    },
    "/applications/{appId}": {
      "schema": { "$ref": "application" },
      "description": "Subscription applications"
    }
  }
}
